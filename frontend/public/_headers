/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Content-Security-Policy: default-src 'self'; img-src 'self' https://bucketbeers.smallwat3r.com data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' https://bucketbeers.smallwat3r.com https://tiles.openfreemap.org; worker-src blob:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'
  Cache-Control: no-cache

/assets/*
  Cache-Control: public, max-age=31536000, immutable
